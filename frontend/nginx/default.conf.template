server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    # O proxy não cria um limite de negócio adicional; cada endpoint backend
    # continua responsável por validar o tamanho aceito.
    client_max_body_size 0;

    # Resolve o private domain novamente durante a vida do container. Railway
    # pode trocar o IP privado de um serviço em um redeploy independente.
    resolver ${FINEMP_DNS_RESOLVER} valid=5s ipv6=off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header Connection "";

        set $finemp_api_upstream ${FINEMP_API_UPSTREAM};
        proxy_pass $finemp_api_upstream$request_uri;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
